{
  "version": 2,
  "builds": [{ "src": "package.json", "use": "@vercel/static-build" }],
  "routes": [
    { "src": "^/assets/(.*)", "headers": { "cache-control": "public, max-age=31536000, immutable" } },
    { "src": "^/(.*).(js|css|png|jpg|jpeg|gif|webp|svg|ico)$", "headers": { "cache-control": "public, max-age=31536000, immutable" } },
    { "src": "/(.*)", "dest": "/index.html" }
  ],
  "github": {
    "silent": true
  }
} 